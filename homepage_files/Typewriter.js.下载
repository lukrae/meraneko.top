function startTypewriter() {
        const alpha = document.getElementById('typewriter');
        if (!alpha) return;
        alpha.style.opacity = '1';
        const text = alpha.textContent;
        alpha.textContent = '';
        let i = 0;
        const timer = setInterval(() => {
            if (i < text.length) {
                alpha.textContent = text.substring(0, i + 1);
                i++;
            } else {
                clearInterval(timer);
            }
        }, 150); //打字速度
    }
